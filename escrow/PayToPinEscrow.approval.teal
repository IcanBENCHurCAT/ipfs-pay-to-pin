    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    len
    intc_1 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    // escrow/contract.py:24
    // assert Txn.sender == self.owner.value, "Only owner can update pricing"
    txn Sender
    intc_2 // 0
    bytec_0 // "owner"
    app_global_get_ex
    assert // check self.owner exists
    ==
    assert // Only owner can update pricing
    // escrow/contract.py:25
    // assert Txn.rekey_to == Global.zero_address, "Transaction must not rekey the account"
    txn RekeyTo
    global ZeroAddress
    ==
    assert // Transaction must not rekey the account
    // escrow/contract.py:26
    // self.base_price.value = new_base
    bytec_1 // "base_price"
    uncover 2
    app_global_put
    // escrow/contract.py:27
    // self.byte_price.value = new_byte_price
    bytec_2 // "byte_price"
    swap
    app_global_put
    // escrow/contract.py:19
    // @arc4.abimethod
    intc_0 // 1
    return


