// contract.PayToPinEscrow.create[routing]() -> void:
create:
    // escrow/contract.py:15
    // self.owner.value = Txn.sender
    bytec_0 // "owner"
    txn Sender
    app_global_put
    // escrow/contract.py:16
    // self.base_price.value = UInt64(1000)  # base microALGO price
    bytec_1 // "base_price"
    pushint 1000
    app_global_put
    // escrow/contract.py:17
    // self.byte_price.value = UInt64(1)     # microALGOs per byte
    bytec_2 // "byte_price"
    intc_0 // 1
    app_global_put
    // escrow/contract.py:13
    // @arc4.abimethod(create="require")
    intc_0 // 1
    return


// contract.PayToPinEscrow.update_pricing[routing]() -> void:
update_pricing:
    // escrow/contract.py:19
    // @arc4.abimethod
    txna ApplicationArgs 1
