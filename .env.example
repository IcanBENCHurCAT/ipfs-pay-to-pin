# IPFS Pay-to-Pin Gateway Environment Variables

# Server Configuration
PORT=4021
NODE_ENV=production

# Algorand & x402 Configuration
ALGORAND_NETWORK=mainnet
ALGORAND_SERVER=https://mainnet-api.algonode.cloud
ESCROW_ADDRESS=ZJEC6JMCNYZFJUQIA4KRVXPTU34F2UQCRZEB5BX5ZS57CPVKTUFK3WA5IY
FACILITATOR_URL=https://facilitator.goplausible.xyz

# IPFS Pinning Provider Credentials
PINATA_JWT=your_pinata_jwt_token_here

# Supabase PostgreSQL Persistence (Optional - Fallbacks to local queue/registry.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Docker & DuckDNS Deployment Configuration
DUCKDNS_SUBDOMAIN=your-duckdns-subdomain
DUCKDNS_TOKEN=your-duckdns-account-token

# Queue Storage & Safety Feature Flags
ALLOW_LOCAL_FALLBACK=true
ENABLE_AUTOMATIC_REFUNDS=false
