#!/bin/bash
# Pre-commit hook: Block commits containing leaked credentials
# This runs BEFORE every commit. If it exits non-zero, the commit is rejected.
#
# Pattern coverage:
# - Supabase project URLs (real, non-placeholder)
# - JWT tokens in source code (not just comments/README examples)
# - PostgreSQL connection strings with real project hosts
# - DuckDNS tokens (UUID format)
# - Real Pinata JWTs in code files

EXIT_CODE=0
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "🔍 Running secret scan on staged files..."
echo ""

# Get staged files (only modified/added, not deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
if [ -z "$STAGED_FILES" ]; then
  echo "  No staged files to scan. ✅"
  exit 0
fi

# Pattern 1: Real Supabase project URLs
# Matches: https://<project>.supabase.co where project is alphanumeric with hyphens
# Excludes: placeholder URLs like "your-project", "example", etc.
echo "  Checking for hardcoded Supabase URLs..."
for file in $STAGED_FILES; do
  [ -f "$file" ] || continue
  
  # Skip binary files
  file_type=$(file -b "$file" 2>/dev/null)
  case "$file_type" in
    *"text"*|*"JSON"*|*"script"*) ;;
    *) continue ;;
  esac
  
  # Check for real Supabase project URLs (not placeholders)
  if grep -nE "https://[a-z0-9-]+\.supabase\.co" "$file" > /dev/null 2>&1; then
    # Verify it's not a placeholder
    if grep -nE "https://(your|example|placeholder|changeme)" "$file" > /dev/null 2>&1; then
      continue  # It's a placeholder, OK
    fi
    # It's a real URL - check if it's in a comment or string
    MATCHES=$(grep -nE "https://[a-z0-9-]+\.supabase\.co" "$file" 2>/dev/null)
    REAL_MATCHES=$(echo "$MATCHES" | grep -vE '^\s*//|^\s*\*|^\s*#|^\s*\*' | head -5)
    if [ -n "$REAL_MATCHES" ]; then
      echo -e "${RED}❌ BLOCKED: Hardcoded Supabase URL in $file${NC}"
      echo "  Found:"
      echo "$REAL_MATCHES" | head -3 | sed 's/^/    /'
      EXIT_CODE=1
    fi
  fi
  
  # Check for PostgreSQL connection strings with real Supabase hosts
  if grep -nE "postgresql://postgres\.[a-z0-9]+" "$file" > /dev/null 2>&1; then
    if grep -nE "postgresql://postgres\.(your|example|placeholder)" "$file" > /dev/null 2>&1; then
      continue  # Placeholder
    fi
    MATCHES=$(grep -nE "postgresql://postgres\.[a-z0-9]+" "$file" 2>/dev/null)
    REAL_MATCHES=$(echo "$MATCHES" | grep -vE '^\s*//|^\s*\*|^\s*#|^\s*\*' | head -5)
    if [ -n "$REAL_MATCHES" ]; then
      echo -e "${RED}❌ BLOCKED: PostgreSQL connection string with real hostname in $file${NC}"
      echo "  Found:"
      echo "$REAL_MATCHES" | head -3 | sed 's/^/    /'
      EXIT_CODE=1
    fi
  fi
  
  # Check for JWT tokens in source code strings (not comments)
  if grep -nE 'eyJhbGciOiJIUzI1NiJ' "$file" > /dev/null 2>&1; then
    if grep -nE 'eyJhbGciOiJIUzI1NiJ.*\.\.\.|"your|PLACEHOLDER|example' "$file" > /dev/null 2>&1; then
      continue  # Placeholder
    fi
    MATCHES=$(grep -nE 'eyJhbGciOiJIUzI1NiJ' "$file" 2>/dev/null)
    REAL_MATCHES=$(echo "$MATCHES" | grep -vE '^\s*//|^\s*\*|^\s*#|^\s*\*|README|\.md' | head -5)
    if [ -n "$REAL_MATCHES" ]; then
      echo -e "${RED}❌ BLOCKED: JWT token in source code in $file${NC}"
      echo "  Found:"
      echo "$REAL_MATCHES" | head -3 | sed 's/^/    /'
      echo -e "${YELLOW}  Hint: Use process.env.JWT_VAR instead of hardcoding.${NC}"
      EXIT_CODE=1
    fi
  fi
  
  # Check for DuckDNS tokens (UUID format in non-example files)
  if grep -nE 'duckdns_token\s*[:=]\s*"[a-f0-9-]{8}-[a-f0-9-]{4}-[a-f0-9-]{4}-[a-f0-9-]{4}-[a-f0-9-]{12}"' "$file" > /dev/null 2>&1; then
    if grep -nE 'duckdns_token.*your|duckdns_token.*example|duckdns_token.*PLACEHOLDER' "$file" > /dev/null 2>&1; then
      continue  # Placeholder
    fi
    if grep -nE 'duckdns_subdomain.*your|duckdns_subdomain.*example' "$file" > /dev/null 2>&1; then
      continue  # Entire file uses placeholders
    fi
    MATCHES=$(grep -nE 'duckdns_token\s*[:=]\s*"[a-f0-9-]{8}-[a-f0-9-]{4}-[a-f0-9-]{4}-[a-f0-9-]{4}-[a-f0-9-]{12}"' "$file" 2>/dev/null)
    REAL_MATCHES=$(echo "$MATCHES" | grep -vE '^\s*//|^\s*\*|^\s*#|^\s*\*|README|\.md' | head -5)
    if [ -n "$REAL_MATCHES" ]; then
      echo -e "${RED}❌ BLOCKED: DuckDNS token in source code in $file${NC}"
      echo "  Found:"
      echo "$REAL_MATCHES" | head -3 | sed 's/^/    /'
      EXIT_CODE=1
    fi
  fi
  
  # Check for hardcoded fallback URLs (process.env.X || "real_url" pattern)
  if grep -nE 'process\.env\.[A-Z_]+\s*\|\|\s*"https?://[a-zA-Z0-9-]+\.' "$file" > /dev/null 2>&1; then
    if grep -nE 'process\.env\.[A-Z_]+\s*\|\|\s*"http[s]?://(your|example|placeholder|changeme)' "$file" > /dev/null 2>&1; then
      continue  # Placeholder fallback
    fi
    MATCHES=$(grep -nE 'process\.env\.[A-Z_]+\s*\|\|\s*"https?://[a-zA-Z0-9-]+\.' "$file" 2>/dev/null)
    REAL_MATCHES=$(echo "$MATCHES" | grep -vE '^\s*//|^\s*\*|^\s*#|^\s*\*' | head -5)
    if [ -n "$REAL_MATCHES" ]; then
      echo -e "${RED}❌ BLOCKED: Hardcoded fallback URL in source code in $file${NC}"
      echo "  Found:"
      echo "$REAL_MATCHES" | head -3 | sed 's/^/    /'
      echo -e "${YELLOW}  Change: process.env.X || "real_url" → process.env.X || undefined${NC}"
      EXIT_CODE=1
    fi
  fi
  
done

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🛑 Commit BLOCKED — credentials detected in staged files."
  echo ""
  echo "  To fix:"
  echo "  1. Replace hardcoded credentials with process.env.VAR references"
  echo "  2. Use .env for local development (gitignored)"
  echo "  3. Example files must use placeholder values (your_project, your_key_here)"
  echo ""
  echo "  If you're sure you want to bypass this check (NOT recommended):"
  echo "    git commit --no-verify"
  echo ""
fi

exit $EXIT_CODE
