{
  "name": "ipfs-pay-to-pin-client",
  "version": "2.0.2",
  "description": "TypeScript client library for pinning files to IPFS via x402 microUSDC micropayments across Base L2, Solana, Algorand, and Ethereum L1.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "homepage": "https://pay-to-pin.duckdns.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/IcanBENCHurCAT/ipfs-pay-to-pin.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ipfs",
    "x402",
    "algorand",
    "usdc",
    "pay-to-pin",
    "micropayments",
    "pinata",
    "multi-chain",
    "solana",
    "base",
    "ethereum",
    "ai-agent"
  ],
  "author": "IcanBENCHurCAT",
  "bugs": {
    "url": "https://github.com/IcanBENCHurCAT/ipfs-pay-to-pin/issues",
    "email": "github@icanbenchur.cat"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "peerDependencies": {
    "@x402/avm": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/svm": "^2.23.0",
    "@x402/core": "^2.23.0",
    "algosdk": "^3.7.0"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@x402/avm": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/svm": "^2.23.0",
    "@x402/core": "^2.23.0",
    "algosdk": "^3.7.0",
    "tsup": "^8.3.6",
    "typescript": "^7.0.2"
  }
}
